/* ==================================================
   BANGIRDI GARMENTTECH — INDUSTRIAL DARK UI
   Tema tambahan; CSS lama tetap dipertahankan
   ================================================== */

:root {
    --gt-bg: #080f1d;
    --gt-panel: #111d30;
    --gt-panel-hover: #172741;
    --gt-blue: #2684ff;
    --gt-blue-light: #69adff;
    --gt-text: #e8f0fc;
    --gt-muted: #9aabc3;
    --gt-border: #263953;
    --gt-radius: 14px;
}

html {
    scroll-behavior: smooth;
}

body {
    background: var(--gt-bg);
    color: var(--gt-text);
    font-family: Arial, Helvetica, sans-serif;
    line-height: 1.6;
}

header {
    position: relative;
    overflow: hidden;
    padding: 34px 18px;
    text-align: center;
    color: #fff;
    background:
        radial-gradient(ellipse at top, #183967 0%, transparent 65%),
        linear-gradient(135deg, #101d32, #080f1d 75%);
    border-bottom: 2px solid var(--gt-blue);
    box-shadow: 0 8px 30px rgba(0, 0, 0, .24);
}

header h1 {
    max-width: 1000px;
    margin: 0 auto;
    font-size: clamp(21px, 4vw, 34px);
    font-weight: 800;
    letter-spacing: 1.3px;
    line-height: 1.3;
    overflow-wrap: anywhere;
}

header p {
    margin: 10px 0 0;
    color: var(--gt-blue-light);
    font-size: 15px;
    letter-spacing: .5px;
}

main {
    width: 100%;
    max-width: 1200px;
    margin: 0 auto;
    padding: 28px 20px;
}

main section {
    margin-bottom: 28px;
}

main section > h2 {
    margin: 0 0 18px;
    padding-bottom: 10px;
    color: var(--gt-text);
    font-size: 21px;
    line-height: 1.4;
    border-bottom: 1px solid var(--gt-border);
}

.welcome,
.database-overview {
    padding: 24px;
    background: linear-gradient(145deg, #14233a, #0e192b);
    border: 1px solid var(--gt-border);
    border-radius: var(--gt-radius);
    box-shadow: 0 10px 28px rgba(0, 0, 0, .2);
}

.welcome h2 {
    color: var(--gt-blue-light);
    margin-top: 0;
}

.welcome p {
    color: #c2d0e4;
}

.welcome form {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 18px;
}

.welcome input[type="text"],
.welcome input[name="search"] {
    flex: 1 1 220px;
    min-width: 0;
    width: 100%;
    padding: 13px 15px;
    color: var(--gt-text);
    background: #080f1d;
    border: 1px solid #344b6b;
    border-radius: 9px;
    outline: none;
    font-size: 15px;
}

.welcome input[type="text"]:focus,
.welcome input[name="search"]:focus {
    border-color: var(--gt-blue);
    box-shadow: 0 0 0 3px rgba(38, 132, 255, .16);
}

.welcome input::placeholder {
    color: #8295af;
}

.welcome form button {
    padding: 12px 24px;
    color: #fff;
    background: var(--gt-blue);
    border: 1px solid var(--gt-blue);
    border-radius: 9px;
    font-weight: 700;
    font-size: 15px;
    cursor: pointer;
    transition: background .2s ease, transform .2s ease;
}

.welcome form button:hover {
    background: #0867df;
    transform: translateY(-1px);
}

.add-button {
    display: inline-block;
    padding: 10px 16px;
    color: #fff;
    background: linear-gradient(135deg, #2684ff, #1263d6);
    border: 1px solid #4596ff;
    border-radius: 9px;
    text-decoration: none;
    font-weight: 700;
    transition: transform .2s ease, box-shadow .2s ease;
}

.add-button:hover {
    opacity: 1;
    transform: translateY(-2px);
    box-shadow: 0 5px 18px rgba(38, 132, 255, .25);
}

.stats-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(130px, 1fr));
    gap: 14px;
}

.stat-card {
    display: flex;
    flex-direction: column;
    justify-content: center;
    min-height: 112px;
    padding: 18px 12px;
    text-align: center;
    background: #0b1526;
    border: 1px solid var(--gt-border);
    border-top: 3px solid var(--gt-blue);
    border-radius: 12px;
    transition: transform .2s ease, border-color .2s ease;
}

.stat-card:hover {
    transform: translateY(-3px);
    border-color: var(--gt-blue);
}

.stat-card strong {
    display: block;
    color: var(--gt-blue-light);
    font-size: clamp(25px, 4vw, 34px);
    line-height: 1.25;
    font-weight: 800;
}

.stat-card span {
    margin-top: 8px;
    color: #b5c5dc;
    font-size: 13px;
}

.grid {
    grid-template-columns: repeat(auto-fit, minmax(190px, 1fr));
    gap: 16px;
}

.grid .card {
    min-width: 0;
    color: var(--gt-text);
    background: linear-gradient(145deg, #14233a, #0e192b);
    border: 1px solid var(--gt-border);
    border-left: 4px solid var(--gt-blue);
    border-radius: 12px;
    box-shadow: 0 6px 18px rgba(0, 0, 0, .16);
    text-decoration: none;
    transition: transform .2s ease, background .2s ease,
                border-color .2s ease, box-shadow .2s ease;
}

.grid .card:hover {
    background: var(--gt-panel-hover);
    border-color: var(--gt-blue);
    transform: translateY(-3px);
    box-shadow: 0 10px 24px rgba(0, 0, 0, .25);
}

.grid .card h3 {
    color: #f0f6ff;
    overflow-wrap: anywhere;
}

.grid .card p {
    color: var(--gt-muted);
}

.brand-logo {
    min-height: 70px;
}

.brand-logo img {
    max-width: 100%;
    filter: drop-shadow(0 2px 5px rgba(0, 0, 0, .12));
}

.machine-list {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 16px;
}

.machine-card {
    min-width: 0;
    padding: 20px;
    color: var(--gt-text);
    background: var(--gt-panel);
    border: 1px solid var(--gt-border);
    border-radius: var(--gt-radius);
    overflow-wrap: anywhere;
}

.machine-card h3 {
    color: var(--gt-blue-light);
    margin-top: 0;
}

.machine-card p {
    color: #c2d0e4;
}

.machine-stats {
    gap: 8px;
}

.machine-stats span {
    color: #cbd9ec;
    background: #0a1424;
    border: 1px solid var(--gt-border);
    border-radius: 7px;
    padding: 5px 9px;
}

.empty {
    padding: 18px;
    color: #f0c9c9;
    background: #281923;
    border: 1px solid #633342;
    border-radius: 10px;
}

.detail-nav {
    background: var(--gt-panel);
    border: 1px solid var(--gt-border);
}

.detail-nav a {
    color: var(--gt-blue-light);
    background: #0a1424;
    border: 1px solid var(--gt-border);
}

.detail-nav a:hover {
    color: #fff;
    background: #172741;
    text-decoration: none;
}

footer {
    margin-top: 30px;
    padding: 24px 16px;
    color: var(--gt-muted);
    background: #070c16;
    border-top: 1px solid var(--gt-border);
}

footer p {
    margin: 0;
}

a {
    transition: color .2s ease;
}

@media (max-width: 600px) {
    header {
        padding: 26px 14px;
    }

    header h1 {
        font-size: 21px;
        letter-spacing: .5px;
    }

    header p {
        font-size: 13px;
    }

    main {
        padding: 16px 12px;
    }

    main section {
        margin-bottom: 22px;
    }

    main section > h2 {
        font-size: 19px;
    }

    .welcome,
    .database-overview {
        padding: 17px;
        border-radius: 12px;
    }

    .welcome form {
        flex-direction: column;
    }

    .welcome form button {
        width: 100%;
    }

    .stats-grid {
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 10px;
    }

    .stat-card {
        min-height: 98px;
        padding: 13px 8px;
    }

    .grid {
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 10px;
    }

    .grid .card {
        padding: 13px 10px;
    }

    .brand-logo {
        height: 58px;
        margin-bottom: 8px;
    }

    .brand-logo img {
        width: 100%;
        height: 58px;
    }

    .machine-list {
        grid-template-columns: 1fr;
    }

    .machine-card {
        padding: 16px;
    }
}

@media (prefers-reduced-motion: reduce) {
    html {
        scroll-behavior: auto;
    }

    *,
    *::before,
    *::after {
        transition-duration: .01ms !important;
    }
}

