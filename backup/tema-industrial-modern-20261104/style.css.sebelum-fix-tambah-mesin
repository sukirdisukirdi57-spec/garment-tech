/* ==========================================
   RESPONSIVE POLISH — HP, TABLET, DESKTOP
   ========================================== */

/* Mencegah lebar elemen menambah lebar halaman */
*,
*::before,
*::after {
    box-sizing: border-box;
}

html,
body {
    max-width: 100%;
}

body {
    overflow-wrap: break-word;
}

main {
    min-width: 0;
}

/* Kartu statistik tetap seimbang */
.stats-grid > * {
    min-width: 0;
    max-width: 100%;
}

/* Katalog merek dan jenis mesin */
.grid {
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 190px), 1fr));
}

.grid .card {
    min-width: 0;
    overflow-wrap: anywhere;
}

/* Tablet */
@media (min-width: 601px) and (max-width: 1024px) {
    main {
        padding: 24px 18px;
    }

    .welcome,
    .database-overview {
        padding: 20px;
    }

    .grid {
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 14px;
    }
}

/* HP */
@media (max-width: 600px) {
    main {
        padding: 18px 12px;
    }

    header {
        padding: 26px 14px;
    }

    header h1 {
        font-size: clamp(20px, 5vw, 27px);
        letter-spacing: .5px;
    }

    .welcome,
    .database-overview {
        padding: 16px 12px;
        border-radius: 12px;
    }

    .stats-grid {
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 10px;
    }

    .stats-grid > :first-child {
        grid-column: 1 / -1;
        width: min(100%, 220px);
        justify-self: center;
    }

    .stat-card {
        min-height: 88px;
        padding: 12px 6px;
    }

    .stat-card strong {
        font-size: clamp(23px, 7vw, 28px);
    }

    .stat-card span {
        font-size: 12px;
        line-height: 1.4;
    }

    .grid {
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 10px;
    }

    .grid .card {
        padding: 12px 8px;
    }
}

/* HP sangat kecil */
@media (max-width: 360px) {
    main {
        padding-right: 8px;
        padding-left: 8px;
    }

    .welcome,
    .database-overview {
        padding: 13px 9px;
    }

    .stats-grid,
    .grid {
        gap: 8px;
    }

    .stat-card span {
        font-size: 11px;
    }

    .grid .card h3 {
        font-size: 13px;
    }
}

/* Menghormati pengaturan animasi perangkat */
@media (prefers-reduced-motion: reduce) {
    *,
    *::before,
    *::after {
        scroll-behavior: auto !important;
        transition-duration: .01ms !important;
        animation-duration: .01ms !important;
        animation-iteration-count: 1 !important;
    }
}

