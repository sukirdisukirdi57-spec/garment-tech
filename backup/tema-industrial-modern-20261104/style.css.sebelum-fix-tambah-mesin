    color: #102d4f;
    font-size: 1.15rem;
    font-weight: 800;
}

body.needle-catalog-page .needle-card h3 a {
    color: #174a85;
}

body.needle-catalog-page .needle-card h3 a:hover {
    color: #d97706;
}

body.needle-catalog-page .needle-card > p {
    color: #475569;
    line-height: 1.6;
}

body.needle-catalog-page .needle-card .needle-button,
body.needle-catalog-page .needle-search button {
    min-height: 44px;
    padding: 11px 18px;
    border: 0;
    border-radius: 9px;
    background: #102d4f;
    color: #ffffff;
    font-weight: 700;
    text-decoration: none;
    cursor: pointer;
    transition: background .2s ease, transform .2s ease;
}

body.needle-catalog-page .needle-card .needle-button:hover,
body.needle-catalog-page .needle-search button:hover {
    background: #f28c28;
    color: #102d4f;
    transform: translateY(-1px);
}

/* Pencarian dan tautan hapus */
body.needle-catalog-page .needle-search > a:not(.needle-button) {
    align-self: center;
    color: #b45309;
    font-weight: 700;
    text-decoration: none;
}

/* Tampilan layar HP */
@media (max-width: 600px) {
    body.needle-catalog-page .needle-main {
        width: calc(100% - 22px);
        margin: 20px auto 28px;
    }

    body.needle-catalog-page .needle-panel {
        padding: 17px;
    }

    body.needle-catalog-page .needle-summary {
        gap: 10px;
    }

    body.needle-catalog-page .needle-summary-card {
        padding: 16px 13px;
    }

    body.needle-catalog-page .needle-card {
        padding: 18px;
    }

    body.needle-catalog-page .needle-search {
        grid-template-columns: 1fr;
    }

    body.needle-catalog-page .needle-search button {
        width: 100%;
    }
}

