* {
    box-sizing: border-box;
}

body {
    margin: 0;
    font-family: Arial, sans-serif;
    background: #f2f4f7;
    color: #222;
}

header {
    background: #17202a;
    color: white;
    padding: 25px 15px;
    text-align: center;
}

header h1 {
    margin: 0;
    font-size: 24px;
}

header p {
    margin: 8px 0 0;
    color: #d5d8dc;
}

main {
    max-width: 1000px;
    margin: auto;
    padding: 20px;
}

section {
    margin-bottom: 22px;
}

.welcome {
    background: white;
    padding: 20px;
    border-radius: 12px;
    box-shadow: 0 2px 8px rgba(0,0,0,0.08);
}

.grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    gap: 15px;
}

.card {
    background: white;
    padding: 18px;
    border-radius: 12px;
    box-shadow: 0 2px 8px rgba(0,0,0,0.08);
    border-left: 5px solid #17202a;
}


.brand-logo {
    width: 100%;
    height: 70px;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 12px;
}

.brand-logo img {
    width: 150px;
    height: 70px;
    object-fit: contain;
    display: block;
}

.card h3 {
    margin-top: 0;
}

.card p {
    color: #666;
    line-height: 1.5;
}

footer {
    text-align: center;
    padding: 20px;
    color: #777;
    font-size: 14px;
}

@media (max-width: 600px) {
    header h1 {
        font-size: 19px;
    }

    main {
        padding: 12px;
    }

    .grid {
        grid-template-columns: 1fr 1fr;
    }

    .card {
        padding: 14px;
    }
}

.add-button {
    display: inline-block;
    padding: 12px 18px;
    background: #17202a;
    color: white;
    text-decoration: none;
    border-radius: 8px;
    font-weight: bold;
}

.add-button:hover {
    opacity: 0.85;
}

.machine-stats {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin: 12px 0 16px;
}

.machine-stats span {
    background: #f3f4f6;
    border-radius: 6px;
    padding: 5px 8px;
    font-size: 0.85rem;
}

.detail-nav {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin: 16px 0 20px;
    padding: 12px;
    background: #f3f4f6;
    border-radius: 8px;
}

.detail-nav a {
    display: inline-block;
    padding: 8px 12px;
    background: #ffffff;
    border-radius: 6px;
    text-decoration: none;
    font-size: 0.9rem;
}

.detail-nav a:hover {
    text-decoration: underline;
}


.machine-detail-back {
    margin-bottom: 20px;
}

#parts-list {
    margin-top: 24px;
}


#parts-list {
    margin-bottom: 28px;
}

.back-button {
    display: inline-block;
    margin-top: 8px;
}


.component-nav-button {
    display: inline-block;
    margin-right: 10px;
    margin-bottom: 10px;
}

.database-overview {
    margin: 20px 0;
}

.database-overview h2 {
    margin-bottom: 14px;
}

.stats-grid {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 12px;
}

.stat-card {
    background: #ffffff;
    border: 1px solid #e5e7eb;
    border-radius: 10px;
    padding: 16px 10px;
    text-align: center;
    box-shadow: 0 2px 6px rgba(0, 0, 0, 0.05);
}

.stat-card strong {
    display: block;
    font-size: 1.7rem;
    margin-bottom: 6px;
}

.stat-card span {
    display: block;
    font-size: 0.9rem;
}

@media (max-width: 768px) {
    .stats-grid {
        grid-template-columns: repeat(2, 1fr);
    }
}

@media (max-width: 420px) {
    .stats-grid {
        grid-template-columns: repeat(2, 1fr);
        gap: 8px;
    }

    .stat-card {
        padding: 14px 8px;
    }

    .stat-card strong {
        font-size: 1.5rem;
    }

    .stat-card span {
        font-size: 0.82rem;
    }
}

/* ================================
   HOME PAGE - HEADER & SEARCH
   ================================ */

header {
    padding: 34px 20px;
    background: linear-gradient(135deg, #17202a, #273746);
}

header h1 {
    font-size: 28px;
    letter-spacing: 0.5px;
}

header p {
    font-size: 1rem;
    margin-top: 10px;
}

.welcome {
    padding: 26px;
    border-radius: 14px;
}

.welcome h2 {
    margin-top: 0;
    margin-bottom: 10px;
    font-size: 1.35rem;
}

.welcome > p {
    color: #555;
}

.welcome form {
    display: flex;
    gap: 10px;
    margin-top: 18px;
}

.welcome form input {
    flex: 1;
    min-width: 0;
    padding: 13px 15px;
    border: 1px solid #d5d8dc;
    border-radius: 8px;
    font-size: 1rem;
    box-sizing: border-box;
}

.welcome form input:focus {
    outline: none;
    border-color: #17202a;
    box-shadow: 0 0 0 2px rgba(23, 32, 42, 0.1);
}

.welcome form button {
    padding: 13px 22px;
    border: none;
    border-radius: 8px;
    background: #17202a;
    color: white;
    font-size: 1rem;
    cursor: pointer;
}

.welcome form button:hover {
    background: #273746;
}

@media (max-width: 600px) {
    header {
        padding: 28px 15px;
    }

    header h1 {
        font-size: 21px;
        line-height: 1.3;
    }

    header p {
        font-size: 0.9rem;
    }

    .welcome {
        padding: 20px;
    }

    .welcome form {
        flex-direction: column;
    }

    .welcome form button {
        width: 100%;
    }
}

/* ================================
   BRAND & MACHINE TYPE CARDS
   ================================ */

.grid {
    gap: 18px;
}

.card {
    position: relative;
    padding: 20px;
    border-radius: 14px;
    border: 1px solid #e5e7eb;
    border-left: 5px solid #17202a;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
    text-decoration: none;
    color: inherit;
}

.card:hover {
    transform: translateY(-4px);
    box-shadow: 0 6px 16px rgba(0, 0, 0, 0.12);
}

.card h3 {
    margin-top: 8px;
    margin-bottom: 8px;
    font-size: 1.05rem;
}

.card p {
    margin: 0;
    color: #666;
    font-size: 0.9rem;
}

.brand-logo {
    height: 75px;
    margin-bottom: 8px;
    padding: 5px;
    background: #fafafa;
    border-radius: 10px;
}

.brand-logo img {
    width: 160px;
    height: 70px;
}

.card .brand-logo + p {
    display: inline-block;
    margin-top: 6px;
    padding: 4px 9px;
    background: #f1f3f5;
    border-radius: 20px;
    font-size: 0.8rem;
}

@media (max-width: 600px) {
    .grid {
        grid-template-columns: repeat(2, 1fr);
        gap: 12px;
    }

    .card {
        padding: 14px;
    }

    .brand-logo {
        height: 62px;
    }

    .brand-logo img {
        width: 130px;
        height: 58px;
    }

    .card h3 {
        font-size: 0.95rem;
    }

    .card p {
        font-size: 0.82rem;
    }
}

@media (max-width: 380px) {
    .grid {
        grid-template-columns: 1fr;
    }
}

/* Warna kartu Brand & Jenis Mesin */

.card {
    background: linear-gradient(145deg, #eef4f8, #dfeaf1);
}

.card:hover {
    background: linear-gradient(145deg, #e4eef5, #d5e3ec);
}

.brand-logo {
    background: rgba(255, 255, 255, 0.75);
}

.card .brand-logo + p {
    background: rgba(255, 255, 255, 0.8);
}

/* ================================
   MACHINE TYPE CARDS
   ================================ */

section > h2 {
    margin-bottom: 16px;
}

section:last-of-type .card {
    background: linear-gradient(145deg, #edf5fa, #dcebf4);
    border-left: 5px solid #2874a6;
    min-height: 110px;
    box-sizing: border-box;
}

section:last-of-type .card h3 {
    margin-top: 0;
    margin-bottom: 10px;
    color: #1f4e6b;
    font-size: 1.08rem;
}

section:last-of-type .card p {
    line-height: 1.5;
    color: #526b78;
}

section:last-of-type .card:hover {
    background: linear-gradient(145deg, #e3f0f7, #d1e4ef);
    border-left-color: #1f618d;
}

@media (max-width: 600px) {
    section:last-of-type .card {
        min-height: 100px;
    }

    section:last-of-type .card h3 {
        font-size: 0.98rem;
    }

    section:last-of-type .card p {
        font-size: 0.82rem;
        line-height: 1.4;
    }
}

/* ================================
   MACHINE DETAIL HERO
   ================================ */

.machine-hero {
    background: linear-gradient(145deg, #17202a, #273746);
    color: white;
    padding: 28px;
    border-radius: 14px;
    margin-bottom: 20px;
    box-shadow: 0 5px 16px rgba(0, 0, 0, 0.12);
}

.machine-hero-label {
    font-size: 0.8rem;
    letter-spacing: 1px;
    opacity: 0.75;
    margin-bottom: 10px;
}

.machine-hero h2 {
    margin: 0;
    font-size: 1.4rem;
}

.machine-model {
    margin-top: 5px;
    font-size: 2rem;
    font-weight: bold;
    letter-spacing: 0.5px;
}

.machine-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 18px;
}

.machine-meta span {
    padding: 7px 11px;
    background: rgba(255, 255, 255, 0.12);
    border-radius: 20px;
    font-size: 0.85rem;
}

.machine-description {
    margin-top: 20px;
    padding-top: 18px;
    border-top: 1px solid rgba(255, 255, 255, 0.15);
}

.machine-description p {
    margin: 7px 0 0;
    line-height: 1.6;
    color: #d5d8dc;
}

@media (max-width: 600px) {
    .machine-hero {
        padding: 22px;
    }

    .machine-hero h2 {
        font-size: 1.2rem;
    }

    .machine-model {
        font-size: 1.65rem;
    }

    .machine-meta {
        flex-direction: column;
        align-items: flex-start;
    }
}

/* ================================
   MACHINE DETAIL NAVIGATION
   ================================ */

.detail-nav {
    background: #eef4f8;
    border: 1px solid #d5e3ec;
    padding: 12px;
    border-radius: 12px;
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-bottom: 24px;
}

.detail-nav a {
    display: inline-block;
    padding: 9px 12px;
    background: white;
    color: #273746;
    border: 1px solid #d5dfe6;
    border-radius: 8px;
    text-decoration: none;
    font-size: 0.88rem;
    transition: background 0.2s ease, transform 0.2s ease;
}

.detail-nav a:hover {
    background: #dcebf4;
    transform: translateY(-2px);
}

@media (max-width: 600px) {
    .detail-nav {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 7px;
    }

    .detail-nav a {
        text-align: center;
        padding: 9px 6px;
        font-size: 0.8rem;
    }
}

