<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Edit Komponen</title>

    <link rel="stylesheet" href="{{ url_for('static', filename='style.css') }}">
</head>

<body>

<header>
    <h1>✏️ Edit Komponen</h1>
</header>

<main>

    <section class="machine-card">

        <h2>
            {{ component["brand_name"] }} — {{ component["model"] }}
        </h2>

        <form method="POST">

            <label for="component_name">
                Nama Komponen
            </label>

            <input
                type="text"
                id="component_name"
                name="component_name"
                value="{{ component['component_name'] }}"
                required
            >

            <label for="part_number">
                Nomor Part
            </label>

            <input
                type="text"
                id="part_number"
                name="part_number"
                value="{{ component['part_number'] or '' }}"
            >

            <label for="location">
                Lokasi
            </label>

            <input
                type="text"
                id="location"
                name="location"
                value="{{ component['location'] or '' }}"
            >

            <label for="function">
                Fungsi
            </label>

            <textarea
                id="function"
                name="function"
                rows="4"
            >{{ component['function'] or '' }}</textarea>

            <label for="notes">
                Catatan
            </label>

            <textarea
                id="notes"
                name="notes"
                rows="4"
            >{{ component['notes'] or '' }}</textarea>

            <br>

            <button type="submit" class="add-button">
                💾 Simpan Perubahan
            </button>

            <a
                href="/machine/{{ component['machine_id'] }}"
                class="add-button"
            >
                ↩️ Kembali
            </a>

        </form>

    </section>

</main>

</body>
</html>
