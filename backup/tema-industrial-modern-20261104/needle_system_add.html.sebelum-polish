<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Tambah Sistem Jarum | Garment Tech</title>
    <style>
        body {
            font-family: Arial, sans-serif;
            margin: 0;
            padding: 16px;
            background: #f3f5f7;
            color: #222;
            line-height: 1.6;
        }
        main {
            max-width: 760px;
            margin: auto;
            background: white;
            padding: 22px;
            border-radius: 10px;
            box-shadow: 0 2px 7px rgba(0,0,0,.08);
        }
        h1 { font-size: 24px; }
        label { display: block; font-weight: bold; margin-bottom: 5px; }
        .field { margin: 15px 0; }
        input, select, textarea {
            width: 100%;
            box-sizing: border-box;
            padding: 11px;
            border: 1px solid #bbb;
            border-radius: 6px;
            font-size: 16px;
            font-family: inherit;
        }
        textarea { min-height: 90px; }
        button {
            padding: 12px 18px;
            border: 0;
            border-radius: 6px;
            background: #075bb5;
            color: white;
            font-size: 16px;
        }
        .notice {
            padding: 12px;
            border-radius: 6px;
            background: #eef5ff;
            margin: 12px 0;
        }
        .error { background: #fff0f0; color: #8b1515; }
        a { color: #075bb5; }
    </style>
</head>
<body>
<main>
    <a href="/needle-systems">← Kembali ke katalog</a>
    <h1>🪡 Tambah Sistem Jarum</h1>
    <p>Masukkan data berdasarkan referensi yang dapat diperiksa.
       Kode sistem wajib diisi.</p>

    <div class="notice">
        Data yang ditambahkan otomatis berstatus
        <strong>Belum diverifikasi</strong>. Menambahkan data tidak
        berarti sistem jarum tersebut cocok dengan semua model mesin.
    </div>

    {% if error %}
    <div class="notice error" role="alert">{{ error }}</div>
    {% endif %}

    <form method="post">
        <input type="hidden" name="_csrf_token" value="{{ csrf_token() }}">
        <div class="field">
            <label for="system_code">Kode sistem jarum *</label>
            <input id="system_code" name="system_code" required
                   maxlength="100" value="{{ values.get('system_code', '') }}"
                   placeholder="Contoh: DB×1">
        </div>

        <div class="field">
            <label for="alternative_names">Nama alternatif</label>
            <input id="alternative_names" name="alternative_names"
                   value="{{ values.get('alternative_names', '') }}"
                   placeholder="Contoh: DBx1; DB X 1">
        </div>

        <div class="field">
            <label for="manufacturer">Merek / produsen</label>
            <input id="manufacturer" name="manufacturer"
                   value="{{ values.get('manufacturer', '') }}"
                   placeholder="Nama produsen jika diketahui">
        </div>

        <div class="field">
            <label for="stitch_type">Jenis jahitan</label>
            <select id="stitch_type" name="stitch_type">
                <option value="">Belum ditentukan</option>
                {% for option in ["Lockstitch", "Chainstitch"] %}
                <option value="{{ option }}"
                    {% if values.get('stitch_type') == option %}selected{% endif %}>
                    {{ option }}
                </option>
                {% endfor %}
            </select>
        </div>

        <div class="field">
            <label for="machine_category">Kategori mesin</label>
            <input id="machine_category" name="machine_category"
                   value="{{ values.get('machine_category', '') }}"
                   placeholder="Kategori mesin jika diketahui">
        </div>

        <div class="field">
            <label for="description">Deskripsi dan catatan</label>
            <textarea id="description" name="description"
                      placeholder="Keterangan berdasarkan sumber">{{ values.get('description', '') }}</textarea>
        </div>

        <div class="field">
            <label for="reference_url">URL referensi resmi</label>
            <input id="reference_url" name="reference_url" type="url"
                   value="{{ values.get('reference_url', '') }}"
                   placeholder="https://...">
        </div>

        <div class="field">
            <label for="verification_notes">Catatan verifikasi</label>
            <textarea id="verification_notes" name="verification_notes"
                      placeholder="Bagian yang sudah diperiksa dan yang belum">{{ values.get('verification_notes', '') }}</textarea>
        </div>

        <p><strong>Status:</strong> Belum diverifikasi</p>
        <button type="submit">Simpan Sistem Jarum</button>
    </form>
</main>
</body>
</html>
