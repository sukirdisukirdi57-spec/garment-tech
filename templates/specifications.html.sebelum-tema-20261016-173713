<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Spesifikasi Mesin - Garment Machine Tech Database</title>
    <link rel="stylesheet"
          href="{{ url_for('static', filename='style.css') }}">
    <style>
        .spec-search {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
            gap: 12px;
            margin: 20px 0;
        }
        .spec-search input,
        .spec-search select {
            width: 100%;
            padding: 11px;
            box-sizing: border-box;
        }
        .spec-table-wrap {
            overflow-x: auto;
            margin-top: 20px;
        }
        .spec-table {
            width: 100%;
            border-collapse: collapse;
            min-width: 650px;
        }
        .spec-table th,
        .spec-table td {
            border: 1px solid #ddd;
            padding: 10px;
            text-align: left;
            vertical-align: top;
        }
        .spec-table th {
            background: #263746;
            color: white;
        }
        .spec-table tr:nth-child(even) {
            background: #f4f6f8;
        }
        .spec-table a {
            font-weight: bold;
        }
        .spec-actions {
            display: flex;
            flex-wrap: wrap;
            gap: 10px;
            align-items: center;
            margin-top: 20px;
        }
    </style>
</head>
<body>
<header>
    <h1>📋 SPESIFIKASI MESIN</h1>
    <p>Garment Machine Tech Database</p>
</header>

<main>
    <section class="welcome">
        <h2>Daftar Spesifikasi Teknis Mesin</h2>
        <p>
            Jumlah seluruh data spesifikasi:
            <strong>{{ total }}</strong>
        </p>

        <form method="GET" action="/specifications">
            <div class="spec-search">
                <div>
                    <label for="brand_id">Merek mesin</label>
                    <select id="brand_id" name="brand_id">
                        <option value="">Semua merek</option>
                        {% for brand in brands %}
                        <option value="{{ brand['id'] }}"
                            {% if brand_id == brand['id'] %}selected{% endif %}>
                            {{ brand['name'] }}
                        </option>
                        {% endfor %}
                    </select>
                </div>

                <div>
                    <label for="model">Model atau seri</label>
                    <input id="model" name="model" type="text"
                           value="{{ model_search }}"
                           placeholder="Contoh: DDL-8000">
                </div>

                <div>
                    <label for="specification">Cari spesifikasi atau nilai</label>
                    <input id="specification" name="specification" type="text"
                           value="{{ spec_search }}"
                           placeholder="Contoh: kecepatan, jarum">
                </div>
            </div>

            <div class="spec-actions">
                <button type="submit" class="add-button">
                    🔎 Cari Spesifikasi
                </button>
                <a href="/specifications" class="back-button">
                    Hapus Filter
                </a>
                <a href="/" class="back-button">🏠 Halaman Utama</a>
            </div>
        </form>

        <p>
            Hasil yang ditampilkan:
            <strong>{{ rows|length }}</strong> data
        </p>

        {% if rows %}
        <div class="spec-table-wrap">
            <table class="spec-table">
                <thead>
                    <tr>
                        <th>Merek</th>
                        <th>Model / Seri</th>
                        <th>Nama Spesifikasi</th>
                        <th>Nilai</th>
                        <th>Catatan</th>
                        <th>Deskripsi</th>
                        <th>Detail</th>
                    </tr>
                </thead>
                <tbody>
                    {% for item in rows %}
                    <tr>
                        <td>{{ item['brand_name'] or '-' }}</td>
                        <td>{{ item['model'] or '-' }}</td>
                        <td>{{ item['specification'] or '-' }}</td>
                        <td>{{ item['value'] or '-' }}</td>
                        <td>{{ item['notes'] or '-' }}</td>
                        <td>{{ item['description'] or '-' }}</td>
                        <td>
                            <a href="/machine/{{ item['machine_id'] }}">
                                Lihat mesin
                            </a>
                        </td>
                    </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
        {% else %}
        <p>Belum ada data yang cocok dengan filter tersebut.</p>
        {% endif %}
    </section>
</main>
</body>
</html>
