<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>{{ component["component_name"] }} - Detail Component</title>

    <link rel="stylesheet"
          href="{{ url_for('static', filename='style.css') }}">
</head>

<body class="component-detail-page">

<header>
    <h1>🔩 DETAIL COMPONENT</h1>
    <p>Garment Machine Tech Database</p>
</header>

<main>

    <section class="component-hero">



        <h2>{{ component["component_name"] }}</h2>

        <div class="component-machine">
            🏭 {{ component["brand_name"] or "Merek belum ada" }}
            {{ component["machine_model"] or "Model belum ada" }}
        </div>

        {% if component["source_url"] %}
        <p class="component-source">
            <strong>📚 Sumber referensi:</strong>
            <a href="{{ component['source_url'] }}"
               target="_blank"
               rel="noopener noreferrer">
                Buka Parts Book {{ component["brand_name"] or "" }} {{ component["machine_model"] or "" }} — {{ component["component_name"] }}
            </a>
        </p>
        {% endif %}

        {% if component["machine_model"] == "BAS-311HN-03S" and component["component_name"] == "Sistem Penjepit Bahan (Clamp)" %}
        <section class="clamp-catalog-links">
            <h3>📐 Diagram Mekanisme Resmi Brother</h3>
            <p>Pilih bagian katalog untuk melihat diagram dan daftar spare part aslinya.</p>
            <ul>
                <li><a href="https://partsbook.brother.co.jp/pub/machine/detail/en/88/2679" target="_blank" rel="noopener noreferrer">C6 — Feed mechanism (halaman katalog 15)</a></li>
                <li><a href="https://partsbook.brother.co.jp/pub/machine/detail/en/88/2683" target="_blank" rel="noopener noreferrer">D1 — Work clamp lifter mechanism (halaman katalog 23)</a></li>
                <li><a href="https://partsbook.brother.co.jp/pub/machine/detail/en/88/2684" target="_blank" rel="noopener noreferrer">D2 — Work clamp lifter mechanism (halaman katalog 25)</a></li>
            </ul>
        </section>
        {% endif %}



        {% if component["machine_id"] == 227 and component["id"] == 529 %}
        <section class="clamp-catalog-links">
            <h3>📐 Diagram Mekanisme Brother — C5</h3>
            <p>
                Feed Mechanism — halaman cetak 13.
                Referensi katalog BAS-311HN/326H; kecocokan khusus
                varian BAS-311HN-03S masih perlu diverifikasi.
            </p>
            <a
                href="{{ url_for('static', filename='images/mechanisms/brother/bas311hn/deploy_bas311hn_C5-feed-mechanism_printed13.png') }}"
                target="_blank"
                rel="noopener noreferrer"
            >
                <img
                    src="{{ url_for('static', filename='images/mechanisms/brother/bas311hn/deploy_bas311hn_C5-feed-mechanism_printed13.png') }}"
                    alt="Diagram C5 Feed Mechanism Brother BAS-311HN, halaman cetak 13"
                    style="max-width:100%; height:auto;"
                >
            </a>
        </section>
        {% endif %}

        {% if component["image_path"] %}
        <div class="component-image">
            <button type="button" id="diagram-open"
                    class="diagram-open"
                    aria-label="Perbesar diagram {{ component['component_name'] }}">
                <img
                    src="{{ url_for('static', filename=component['image_path']) }}"
                    alt="{{ component['component_name'] }}"
                    loading="lazy">
                <span>🔍 Ketuk gambar untuk memperbesar</span>
            </button>
        </div>
        {% endif %}


    </section>


    <section class="component-info">

        <h2>📋 Informasi Teknis</h2>

        <div class="component-info-grid">

            {% if component["part_number"] %}
            <div class="component-info-item">
                <strong>🔢 Nomor Part</strong>
                <span>{{ component["part_number"] }}</span>
            </div>
            {% endif %}

            {% if component["catalog_ref"] %}
            <div class="component-info-item">
                <strong>📖 Ref. Katalog</strong>
                <span>{{ component["catalog_ref"] }}</span>
            </div>
            {% endif %}

            {% if component["diagram_page"] %}
            <div class="component-info-item">
                <strong>📄 Halaman Diagram</strong>
                <span>{{ component["diagram_page"] }}</span>
            </div>
            {% endif %}

            {% if component["location"] %}
            <div class="component-info-item">
                <strong>📍 Lokasi</strong>
                <span>{{ component["location"] }}</span>
            </div>
            {% endif %}

            {% if component["function"] %}
            <div class="component-info-item full-width">
                <strong>⚙️ Fungsi</strong>
                <span>{{ component["function"] }}</span>
            </div>
            {% endif %}

            {% if component["notes"] %}
            <div class="component-info-item full-width">
                <strong>📝 Catatan</strong>
                <span>{{ component["notes"] }}</span>
            </div>
            {% endif %}

        </div>

    </section>



    {% if component["id"] == 475 %}
    <section class="component-info" id="brother84-mechanism-diagram">
        <h2>📐 Diagram B — Upper Shaft Mechanism</h2>
        <p>
            Brother T-8421D · Diagram mekanisme dan daftar suku cadang
        </p>

        <div style="text-align:center; margin:18px 0;">
            <a href="{{ url_for('static', filename='images/mechanisms/brother/t-8421d/section-b-upper-shaft.png') }}"
               target="_blank" rel="noopener">
                <img
                    src="{{ url_for('static', filename='images/mechanisms/brother/t-8421d/section-b-upper-shaft.png') }}"
                    alt="Diagram B Upper Shaft Mechanism Brother T-8421D"
                    loading="lazy"
                    style="display:block; width:100%; max-width:850px; height:auto; margin:auto; background:#fff; border:1px solid #dce5ee; border-radius:10px;"
                >
            </a>
            <small>Ketuk gambar untuk membukanya dalam ukuran penuh.</small>
        </div>

        <h3>Gambar Katalog Part Number — Diagram B</h3>
        <div style="text-align:center; margin:18px 0;">
            <a href="{{ url_for('static', filename='images/mechanisms/brother/t-8421d/section-b-parts-catalog.png') }}"
               target="_blank" rel="noopener">
                <img
                    src="{{ url_for('static', filename='images/mechanisms/brother/t-8421d/section-b-parts-catalog.png') }}"
                    alt="Gambar katalog tabel Part Number Brother T-8421D Diagram B"
                    loading="lazy"
                    style="display:block; width:100%; max-width:850px; height:auto; margin:auto; background:#fff; border:1px solid #dce5ee; border-radius:10px;"
                >
            </a>
            <small>Ketuk gambar untuk membuka katalog dalam ukuran penuh.</small>
        </div>

        <h3>Daftar Part dan Nomor Referensi</h3>

        {% if sub_parts %}
        <div class="component-subparts-wrapper">
            <table class="component-subparts">
                <thead>
                    <tr>
                        <th style="padding:10px; text-align:left;">Ref.</th>
                        <th style="padding:10px; text-align:left;">Part Number</th>
                        <th style="padding:10px; text-align:left;">Nama Part</th>
                        <th style="padding:10px; text-align:center;">Qty</th>
                    </tr>
                </thead>
                <tbody>
                    {% for part in sub_parts %}
                    <tr>
                        <td style="padding:9px; border-top:1px solid #dce5ee;">
                            {{ part["catalog_ref"] if part["catalog_ref"] is not none else "—" }}
                        </td>
                        <td style="padding:9px; border-top:1px solid #dce5ee;">
                            <strong>{{ part["part_number"] }}</strong>
                        </td>
                        <td style="padding:9px; border-top:1px solid #dce5ee;">
                            {{ part["part_name"] }}
                        </td>
                        <td style="padding:9px; border-top:1px solid #dce5ee; text-align:center;">
                            {{ part["quantity_raw"] or part["quantity"] or "—" }}
                        </td>
                    </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
        {% else %}
        <p>Belum ada part yang terhubung dengan mekanisme ini.</p>
        {% endif %}
    </section>
    {% endif %}


